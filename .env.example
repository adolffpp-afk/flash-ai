# Copy this file to .env.local and fill in the keys you have.
# Any engine without a key runs in demo mode.

# Writing, research (web search) and file questions — https://console.anthropic.com
ANTHROPIC_API_KEY=

# Image generation — https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Voice (text to speech) — https://elevenlabs.io/app/settings/api-keys
ELEVENLABS_API_KEY=

# Optional overrides
# FLASH_TEXT_MODEL=claude-opus-5-5
# FLASH_IMAGE_MODEL=gpt-image-1
# ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
# ELEVENLABS_MODEL=eleven_multilingual_v2
