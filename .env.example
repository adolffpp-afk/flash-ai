# Copy this file to .env.local and fill in the keys you have.
# Any engine without a key runs in demo mode.

# Writing, research, code, translation, docs and sheets — https://console.anthropic.com
ANTHROPIC_API_KEY=

# Images and video — https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Voice, music and transcription — https://elevenlabs.io/app/settings/api-keys
ELEVENLABS_API_KEY=

# Optional: more image, video and music models through one key — https://fal.ai/dashboard/keys
# Adds FLUX.2 Pro (photos), Veo 3.1 (video with sound), Kling 3 (clips up to 15 s)
# and MiniMax Music 2.6 (songs with sung lyrics). Flash picks the right one per request.
FAL_KEY=

# Optional, free: open-source models for users who run out of credits. All three have free
# tiers with no card. Flash stays under each free limit, so these never cost you anything.
# Groq (chat, GPT-OSS 120B): https://console.groq.com/keys
GROQ_API_KEY=
# OpenRouter (backup chat, free Llama models): https://openrouter.ai/keys
OPENROUTER_API_KEY=
# Cloudflare Workers AI (free images with FLUX.1 schnell, plus backup chat):
# https://dash.cloudflare.com/profile/api-tokens with the "Workers AI" permission
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
# FLASH_FREE_DAILY_CHATS=25     # free messages per user per day once credits run out
# FLASH_FREE_DAILY_IMAGES=3     # free images per user per day once credits run out
# FLASH_OPENROUTER_DAILY_REQUESTS=45   # raise to 950 after a one-time $10 OpenRouter top-up

# Owner dashboard at /admin: the email(s) of your own account, comma separated
FLASH_ADMIN_EMAILS=

# Shown on the terms and privacy pages
# FLASH_CONTACT_EMAIL=support@your-domain.com
# FLASH_COMPANY_NAME=Flash AI

# Optional overrides
# Claude models: Opus builds apps, slides and code; Sonnet handles chat, writing, research
# and translation; Haiku picks the engine when the keyword rules can't.
# FLASH_BUILD_MODEL=claude-opus-5-5
# FLASH_CHAT_MODEL=claude-sonnet-5-5
# FLASH_ROUTER_MODEL=claude-haiku-4-5
# FLASH_TEXT_MODEL=claude-opus-5-5          # sets both build and chat models at once
# FLASH_IMAGE_MODEL=gpt-image-2.5-sunburst   # or gpt-image-2.5-flare for speed
# FLASH_IMAGE_SIZE=1024x1024
# FLASH_VIDEO_MODEL=sora-2-pro              # or sora-2 for speed and lower cost
# ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
# ELEVENLABS_MODEL=eleven_v4
# ELEVENLABS_MUSIC_MODEL=music_v2_5
# ELEVENLABS_STT_MODEL=scribe_v2

# Accounts and data. Leave blank to use a local file (flash.db).
# For production use a hosted libSQL database such as Turso: https://turso.tech
# DATABASE_URL=libsql://your-db.turso.io
# DATABASE_AUTH_TOKEN=

# Credits
# FLASH_FREE_CREDITS=200        # free credits each user gets every month
# FLASH_MARKUP=2.5              # credits charged = provider cost in cents x markup
# FLASH_DEMO_PURCHASES=true     # "Buy" and plans add test credits when Stripe isn't set up (never in production)

# Account emails (email confirmation and password reset) — https://resend.com/api-keys
# Without it, email confirmation is off and "Forgot password" says to contact you.
# RESEND_API_KEY=
# FLASH_EMAIL_FROM=Flash AI <hello@yourdomain.com>   # a sender on a domain verified in Resend
# FLASH_DEMO_EMAILS=true        # shows email links on screen for testing (never in production)

# Payments (Stripe Checkout) — https://dashboard.stripe.com/apikeys
# Point a webhook at https://your-site/api/billing/webhook for checkout.session.completed,
# invoice.paid, customer.subscription.updated and customer.subscription.deleted
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# FLASH_CURRENCY=usd
