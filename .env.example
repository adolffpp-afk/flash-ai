# Copy this file to .env.local and fill in the keys you have.
# Any engine without a key runs in demo mode.

# Writing, research, code, translation, docs and sheets — https://console.anthropic.com
ANTHROPIC_API_KEY=

# Images and video — https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Voice, music and transcription — https://elevenlabs.io/app/settings/api-keys
ELEVENLABS_API_KEY=

# Optional: more image, video and music models through one key — https://fal.ai/dashboard/keys
# Adds FLUX.2 Pro (photos), Veo 3.1 (video with sound), Kling 3 (clips up to 15 s)
# and MiniMax Music 2.6 (songs with sung lyrics). Flash picks the right one per request.
FAL_KEY=

# Optional, free: models for users who run out of credits. All of these have free tiers with
# no card. Flash stays under each free limit, so these never cost you anything.
# Groq (chat, GPT-OSS 120B): https://console.groq.com/keys
GROQ_API_KEY=
# Google Gemini (chat, outside Europe, the UK and Switzerland): https://aistudio.google.com/apikey
# Make it in a Google Cloud project with billing never turned on.
GEMINI_API_KEY=
# OpenRouter (backup chat, free Llama models): https://openrouter.ai/keys
OPENROUTER_API_KEY=
# Cloudflare Workers AI (free images with FLUX.1 schnell, plus backup chat):
# https://dash.cloudflare.com/profile/api-tokens with the "Workers AI" permission
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
# Mistral (last backup chat, Mistral Small): https://console.mistral.ai/api-keys
# First turn off training: admin.mistral.ai > Privacy > Anonymous improvement data. Never add a card.
MISTRAL_API_KEY=
# FLASH_FREE_DAILY_CHATS=25     # free messages per user per day once credits run out
# FLASH_FREE_DAILY_IMAGES=3     # free images per user per day once credits run out
# FLASH_OPENROUTER_DAILY_REQUESTS=45   # raise to 950 after a one-time $10 OpenRouter top-up

# Optional, free: public data the AI can look up. Each tool stays hidden until its variables are set.
# Steps for each: docs/research-sources-setup.md
# Web search through your own SearXNG (the password-protected address, https only). Users out of
# credits get a free web search; paid Research keeps its own.
# SEARXNG_URL=https://your-searxng.up.railway.app
# SEARXNG_USERNAME=
# SEARXNG_PASSWORD=             # add it in Vercel as Sensitive
# FLASH_FREE_DAILY_SEARCHES=20         # free web searches per user per day
# FLASH_SEARXNG_DAILY_REQUESTS=5000    # searches Flash sends SearXNG per day, everyone together
# SEC EDGAR (company filings and reported figures) needs no key. It uses FLASH_CONTACT_EMAIL in its User-Agent.
# FLASH_SEC_DAILY_REQUESTS=20000
# FRED economic data, free key: https://fredaccount.stlouisfed.org/apikeys (add it in Vercel as Sensitive)
# FRED_API_KEY=
# FLASH_FRED_DAILY_REQUESTS=10000

# Google PageSpeed Insights: speed and SEO scores in My websites & apps › SEO. Free, no paid tier.
# Without a key Google usually refuses (its shared keyless quota can be 0). Google Cloud console ›
# APIs & Services › enable "PageSpeed Insights API" › Credentials › Create API key › restrict it to that API.
# Steps: docs/research-sources-setup.md
# PAGESPEED_API_KEY=            # add it in Vercel as Sensitive
# FLASH_PAGESPEED_DAILY_REQUESTS=5000   # requests a day, everyone together (each check is 2)
# FLASH_TEST_PAGESPEED_URL=     # a local https stand-in only; ignored on Vercel

# Owner dashboard at /admin: the email(s) of your own account, comma separated
FLASH_ADMIN_EMAILS=

# Connectors (users' own accounts in chat): the key that encrypts their API keys and tokens.
# Make one on /admin > By provider > "Make a connector key" (it never leaves your browser), and
# add it in Vercel as Sensitive. Until it is set, users don't see connectors at all.
# Steps and rotation: docs/connectors-setup.md
# CONNECTOR_KEYS={"v1":"<32 random bytes in base64>"}
# FLASH_CONNECT_MOCK=http://127.0.0.1:7788   # dev only: lets the local mock (scripts/mock-connectors.ts) stand in for every server; ignored on Vercel
# GitHub in chat: Flash's own GitHub App (not the sign-in app further down). GitHub shows in
# Settings > Connectors only once all three are set, and CONNECTOR_KEYS. Steps: docs/connectors-setup.md
# GITHUB_APP_CLIENT_ID=
# GITHUB_APP_CLIENT_SECRET=      # Sensitive
# GITHUB_APP_SLUG=               # the app's name in its address: github.com/apps/<slug>
# Google Drive in chat: Flash's own Google Cloud project "Flash AI Connectors" (not the Google
# sign-in client further down). Google Drive shows in Settings > Connectors only once all four are
# set, and CONNECTOR_KEYS. Steps: docs/connectors-setup.md
# GOOGLE_CONNECT_CLIENT_ID=
# GOOGLE_CONNECT_CLIENT_SECRET=  # Sensitive
# GOOGLE_PICKER_API_KEY=         # the Picker's API key (restricted to your site and the Picker API)
# GOOGLE_CONNECT_PROJECT_NUMBER= # the project's number (digits), from the Cloud console's Dashboard
# MALLOC_ARENA_MAX=2             # keeps the memory PDFs from Drive used from building up. It must be in the
#                                # environment when the server starts: add it in Vercel → Environment Variables and redeploy
#                                # (a .env file is read too late for it; locally, start with MALLOC_ARENA_MAX=2 npm start)

# Alerts on phones and computers when Flash is closed (Web Push). Free: browsers' own push services
# carry them, with no Google project and no other service. Make the keys on /admin > By provider >
# "Make push keys" (the private key never leaves your browser), add all three in Vercel as Sensitive
# and redeploy. Until all three are set, nobody sees the alerts setting and Flash sends no alerts.
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:hello@flash-app.dev

# Shown on the terms and privacy pages, and sent to MET Norway and the SEC with their requests (their terms ask for a contact)
# FLASH_CONTACT_EMAIL=support@your-domain.com
# FLASH_COMPANY_NAME=AI-Flash Inc.   # the default; set it only to name another company

# Optional overrides
# Claude models: Opus builds apps, slides and code; Sonnet handles chat, writing, research
# and translation; Haiku picks the engine when the keyword rules can't.
# FLASH_BUILD_MODEL=claude-opus-5-5
# FLASH_CHAT_MODEL=claude-sonnet-5-5
# FLASH_ROUTER_MODEL=claude-haiku-4-5
# FLASH_TEXT_MODEL=claude-opus-5-5          # sets both build and chat models at once
# FLASH_IMAGE_MODEL=gpt-image-2.5-sunburst   # or gpt-image-2.5-flare for speed
# FLASH_IMAGE_SIZE=1024x1024
# FLASH_VIDEO_MODEL=sora-2-pro              # or sora-2 for speed and lower cost
# ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
# ELEVENLABS_MODEL=eleven_v4
# ELEVENLABS_MUSIC_MODEL=music_v2_5
# ELEVENLABS_STT_MODEL=scribe_v2

# Accounts and data. Leave blank to use a local file (flash.db).
# For production use a hosted libSQL database such as Turso: https://turso.tech
# DATABASE_URL=libsql://your-db.turso.io
# DATABASE_AUTH_TOKEN=

# Credits
# FLASH_FREE_CREDITS=200        # free credits each user gets every month
# FLASH_MARKUP=2.5              # credits charged = provider cost in cents x markup
# FLASH_DEMO_PURCHASES=true     # "Buy" and plans add test credits when Stripe isn't set up (never in production)

# Account emails (email confirmation and password reset) — https://resend.com/api-keys
# Without it, email confirmation is off and "Forgot password" says to contact you.
# RESEND_API_KEY=
# FLASH_APP_URL=https://yourdomain.com   # the address used in email links and Stripe redirects
# FLASH_EMAIL_FROM=Flash Infinity AI <hello@yourdomain.com>   # a sender on a domain verified in Resend
# FLASH_DEMO_EMAILS=true        # shows email links on screen for testing (never in production)

# "Continue with Google / GitHub / Microsoft" buttons; each shows once its pair is set.
# Step-by-step setup: docs/sign-in-setup.md
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# MICROSOFT_CLIENT_ID=
# MICROSOFT_CLIENT_SECRET=

# Payments (Stripe Checkout) — https://dashboard.stripe.com/apikeys
# Point a webhook at https://your-site/api/billing/webhook for checkout.session.completed,
# checkout.session.async_payment_succeeded, invoice.paid, customer.subscription.updated,
# customer.subscription.deleted, charge.refunded and charge.dispute.created
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# Selling from published apps (sellers' connected accounts): a second webhook, in the Stripe
# Dashboard under Developers > Webhooks, that listens to "Events on connected accounts", at
# https://your-site/api/stripe/connect, for checkout.session.completed,
# checkout.session.async_payment_succeeded, charge.refunded and charge.dispute.created. Its signing
# secret goes here. Until it's set the address refuses every call, and orders are still saved when
# buyers come back from paying or the owner opens Orders.
# STRIPE_CONNECT_WEBHOOK_SECRET=
# FLASH_CURRENCY=usd
# Adds sales tax (GST/HST, VAT, US sales tax) on top of prices at checkout through Stripe Tax.
# Turn on only after setting up Stripe Tax in the Stripe dashboard, or checkout fails.
# FLASH_STRIPE_TAX=true
